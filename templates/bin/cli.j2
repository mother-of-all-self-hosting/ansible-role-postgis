# Runs psql inside the (running) PostGIS container, connecting the same way the managed databases preparation does.
# The credentials come from the env-postgis-psql file, which Docker reads itself, so that they do not appear on any command line.
# A TTY is only requested when there is one, so that SQL can also be piped in (e.g. `echo 'SELECT 1' | cli`).
docker_exec_args=(-i)
if [ -t 0 ]; then
    docker_exec_args+=(-t)
fi

exec docker exec \
    "${docker_exec_args[@]}" \
    --env-file={{ postgis_base_path }}/env-postgis-psql \
    {{ postgis_identifier }} \
    psql -h {{ postgis_run_path_in_container if postgis_cli_use_unix_socket_enabled else '127.0.0.1' }} \
    "$@"
