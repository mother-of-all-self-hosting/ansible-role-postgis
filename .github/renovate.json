{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mother-of-all-self-hosting/renovate-config#v1.0.0"
  ],
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "A new PostGIS major becomes a new variable, never a bump of an old one",
      "matchPackageNames": ["postgis/postgis"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main.yml$/"
      ],
      "matchStrings": [
        "(?<name>postgis_container_image_v\\d+_version):\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "postgis/postgis",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
